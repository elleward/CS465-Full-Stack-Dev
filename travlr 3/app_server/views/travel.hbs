<div id="background">
    <div id="page">
        {{> header}}
        <div id="contents">
            <div class="box">
                <div>
                    <div class="body">
                        <h1>Travel</h1>
                        <ul id="sites">
                        {{#each trips}}
                            <li>
                                <a href="/api/trips/{{this.code}}"><img src="images/{{this.image}}" /></a>
                                <h2><a href="travel.html">{{this.name}}</a></h2>
                                {{{this.description}}}
                            </li>
                        {{/each}}
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        {{> footer}}
        <p>© 2023 by BHACCASYONIZTAS BEACH RESORT. All Rights Reserved</p>
    </div>
</div>